{
  "name": "class-desktop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run ocr:assets",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "pretest:e2e": "node scripts/generate-ocr-fixture.mjs",
    "test:e2e": "playwright test",
    "ocr:assets": "node scripts/sync-ocr-assets.mjs",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1 -Configuration Release",
    "android:open": "cap open android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
